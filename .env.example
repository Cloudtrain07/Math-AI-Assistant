# 复制本文件为 .env 并填入你的密钥：复制 .env.example 并改名为 .env
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 2026-07 起官方新模型名：deepseek-v4-flash（快速）/ deepseek-v4-pro（更强）
DEEPSEEK_MODEL=deepseek-v4-flash
# 思考模式：true 开启（数学更严谨，速度稍慢）；false 关闭
DEEPSEEK_THINKING=false
# 思考强度：low / high / max（仅思考模式生效）
DEEPSEEK_REASONING_EFFORT=high
# 保留的最大历史消息条数（建议偶数，超出后自动丢弃最旧消息）
MAX_HISTORY_MESSAGES=20
# 单次回答的最大输出 token 数（思考模式的推理 token 也计入；难题长解答可调大）
MAX_OUTPUT_TOKENS=30000
# 单次请求最长等待秒数（含思考时间），超时自动停止，避免无限等待
MAX_WAIT_SECONDS=600
# 单条消息最大长度（字符），超长输入直接拒绝
MAX_MESSAGE_LEN=2000
# 每日每访客 token 上限（成本护栏，按访问者 IP 独立计算，自然日零点重置）
DAILY_TOKEN_LIMIT=1000000
# 全局每日 token 总上限（成本护栏第二道保险，所有访客合计）
GLOBAL_DAILY_TOKEN_LIMIT=3000000

# ===== 视觉识图（可选：用于拍照/粘贴题目图片）=====
# 阿里云百炼 OpenAI 兼容接口；可在 https://bailian.console.aliyun.com/ 获取 Key
DASHSCOPE_API_KEY=sk-百炼密钥
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-flash-2026-07-15
