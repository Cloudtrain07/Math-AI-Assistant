# 仅在没有 .env 时复制本文件；填写实际使用服务商的密钥，未使用的密钥项留空
# 不要覆盖已有配置，也不要把密钥或占位文字当作可用凭据；修改后重启

# DeepSeek 密钥；也可使用其他已配置服务商，不强制使用 DeepSeek
DEEPSEEK_API_KEY=sk-你的密钥

# OpenAI 密钥（可选）；无自定义清单时有内置 OpenAI，复制 DeepSeek 模板后需自行添加条目
OPENAI_API_KEY=sk-你的OpenAI密钥

# 以下为默认设置；已有系统环境变量优先于 .env
# 默认思考模式：true 开启；false 关闭。是否支持由所选模型决定，不保证答案正确
DEEPSEEK_THINKING=false

# 环境默认强度接受 low / high / max；页面按当前模型规则显示档位，不是所有模型都有强度选项
DEEPSEEK_REASONING_EFFORT=high

# ========================================
# 发给模型的近期历史消息条数（不是轮数，建议正偶数）；超出窗口的较早内容压缩为摘要
# 摘要并非完整原文，生成时可能额外调用模型；此设置不删除本地已保存的历史
MAX_HISTORY_MESSAGES=20

# 请求的最大输出 token 数；推理计入方式和可接受上限取决于实际服务商与模型
MAX_OUTPUT_TOKENS=30000

# 单次请求最长等待秒数（含思考时间），超时自动停止，避免无限等待
MAX_WAIT_SECONDS=600

# 单条消息最大长度（字符），超长输入直接拒绝
MAX_MESSAGE_LEN=2000

# =========================================
# 每账号每日 token 检查阈值（按服务器本地自然日）；发送前检查、完成后累计，不是硬费用上限
DAILY_TOKEN_LIMIT=1000000

# 全部账号每日 token 合计检查阈值；单次请求与并发可能超过阈值，不替代服务商账单管理
GLOBAL_DAILY_TOKEN_LIMIT=3000000

# ==========================================
# 首次创建有效账号清单时的数量（默认 5）；已有清单不随此值扩增，以 data/accounts.json 为准
ACCOUNT_COUNT=5

# 启动时是否自动打开浏览器：true / false；--no-browser 可关闭，--isolated 默认不打开
AUTO_OPEN_BROWSER=true
